#!/usr/bin/env bash
set -euo pipefail

DST="${SONY_DST:-/mnt/Disco/Sony-camera}"
VDST="$(dirname "$DST")/Sony-videos"
MOUNT=/run/media/awe/SONY
SRC="$MOUNT/DCIM"

[ -d "$SRC" ] || { echo "SD no conectada ($SRC)"; exit 1; }

find "$SRC" -type f -iname '*.arw' -printf '%TY-%Tm-%Td\t%p\n' | \
while IFS=$'\t' read -r date path; do
  mkdir -p "$DST/$date"
  cp -n "$path" "$DST/$date/" && echo "  $date/$(basename "$path")"
done
echo "Listo: ARW importados a $DST/<date>/"

mkdir -p "$VDST"
find "$MOUNT" -type f -iname '*.mp4' -print -exec cp -n -t "$VDST" {} +
echo "Listo: videos volcados a $VDST/"

if [ "${1:-}" = "--clean" ]; then
  find "$MOUNT" -mindepth 1 -delete
  echo "SD limpiada: $MOUNT vacío"
fi
