#!/usr/bin/env python3
"""Move windows spawned inside the pip terminal's special workspace onto the
active normal workspace, so GUI windows don't get stuck behind the terminal."""
import os, socket, subprocess, json

his = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
sock_path = f"{runtime}/hypr/{his}/.socket2.sock"

conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
conn.connect(sock_path)

buf = b""
while True:
    chunk = conn.recv(4096)
    if not chunk:
        break
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        event = line.decode("utf-8", "replace")
        if not event.startswith("openwindow>>"):
            continue
        parts = event[len("openwindow>>"):].split(",", 3)
        if len(parts) < 3:
            continue
        address, workspace, wclass = parts[0], parts[1], parts[2]
        if workspace != "special:pip" or wclass == "pipterm":
            continue
        monitors = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"]))
        target = next(m["activeWorkspace"]["id"] for m in monitors if m["focused"])
        subprocess.run(["hyprctl", "dispatch", "movetoworkspacesilent",
                        f"{target},address:0x{address}"])
